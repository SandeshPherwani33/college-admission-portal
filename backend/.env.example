APP_NAME=UniApply-AI
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=*
JWT_SECRET_KEY=<generate-a-random-secret-of-at-least-32-characters>
JWT_ALGORITHM=HS256
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/uniapply_ai
MONGODB_DATABASE=uniapply_ai
# Optional in development; required in production. Must be private and persistent.
# DOCUMENT_STORAGE_DIR=/path/to/private/persistent/storage
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=ollama
LLM_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60000
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
